#!/usr/bin/env bash
# Starts the Google Workspace MCP server in external-OAuth mode for
# the metis Gmail connector. Used by Procfile.dev. The server
# validates the bearer metis sends against Google's userinfo API and
# dispatches Gmail tools based on the token's scopes; metis never
# gives it a refresh token or its own consent flow.
#
# Default install: `uvx` pulls the fork (chagel/google_workspace_mcp)
# straight from GitHub on first run and caches it — no source checkout
# to maintain. Override `WORKSPACE_MCP_SOURCE` to pin a tag/commit, or
# set `WORKSPACE_MCP_PROJECT` to a local checkout when you're developing
# the server itself.
#
# Auto-restarts on crash with exponential backoff (capped at 30s) so a
# transient failure doesn't take down the dev shell with it.

set -e

# OAuth credentials are loaded by foreman from .env. The Devise
# initializer reads the same vars; both processes agree on the
# client id/secret that the user's grant was issued against.
export GOOGLE_OAUTH_CLIENT_ID
export GOOGLE_OAUTH_CLIENT_SECRET

export WORKSPACE_MCP_PORT=${WORKSPACE_MCP_PORT:-10299}
# Unset PORT so the server uses WORKSPACE_MCP_PORT rather than the
# generic PORT that foreman injects (which collides with the web process).
unset PORT
export MCP_ENABLE_OAUTH21=true
export EXTERNAL_OAUTH21_PROVIDER=true
export WORKSPACE_MCP_STATELESS_MODE=true

# The package source. uv understands `git+<url>@<ref>` so the same
# value can pin a tag (…@v1.2.3) or a commit (…@<sha>).
SOURCE="${WORKSPACE_MCP_SOURCE:-git+https://github.com/chagel/google_workspace_mcp}"
PROJECT="${WORKSPACE_MCP_PROJECT:-}"  # local checkout, optional

# Choose the run command:
#   - WORKSPACE_MCP_PROJECT set + uv available → run from local source
#   - uv available                              → uvx from git URL
#   - workspace-mcp on PATH                     → run the installed binary
# Fall through with a clear instruction when nothing works.
build_cmd() {
  if [ -n "$PROJECT" ] && [ -d "$PROJECT" ] && command -v uv &> /dev/null; then
    echo "uv run --project $PROJECT workspace-mcp"
  elif command -v uv &> /dev/null; then
    echo "uvx --from $SOURCE workspace-mcp"
  elif command -v workspace-mcp &> /dev/null; then
    echo "workspace-mcp"
  fi
}

CMD=$(build_cmd)
if [ -z "$CMD" ]; then
  echo "[workspace-mcp] Neither 'uv' nor an installed 'workspace-mcp' binary is on PATH." >&2
  echo "[workspace-mcp] Install uv (https://docs.astral.sh/uv) or pipx install workspace-mcp." >&2
  echo "[workspace-mcp] (Or comment out the workspace_mcp line in Procfile.dev.)" >&2
  exit 0
fi

DELAY=1
while true; do
  $CMD --transport streamable-http --permissions gmail:drafts
  echo "[workspace-mcp] Process exited ($?), restarting in ${DELAY}s..." >&2
  sleep $DELAY
  DELAY=$((DELAY < 30 ? DELAY * 2 : 30))
done
