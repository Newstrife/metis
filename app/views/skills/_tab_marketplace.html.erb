<p class="form-hint">
  Curated picks from <a href="https://github.com/anthropics/skills" target="_blank" rel="noopener">anthropics/skills</a>.
  Click <strong>Install</strong> to import into your team. Imported skills
  show up under <em>Your skills</em> and behave like any other team skill.
</p>

<div class="conn-list">
  <% @featured.each do |entry| %>
    <% slug = File.basename(entry.source) %>
    <% installed = @existing_slugs.include?(slug) %>
    <div class="conn-row">
      <div style="flex:1">
        <div class="conn-name"><%= entry.label %> <span class="form-hint">— <%= slug %></span></div>
        <div class="conn-desc"><%= entry.description %></div>
      </div>
      <% if installed %>
        <span class="badge">Installed</span>
      <% else %>
        <%= button_to "Install", import_skills_path,
              params: { url: entry.source },
              method: :post,
              class: "btn btn-ghost",
              form: { class: "inline-form" } %>
      <% end %>
    </div>
  <% end %>
</div>

<p class="form-hint" style="margin-top:1.25rem">
  Want something not in this list?
  <%= link_to "Import from any GitHub URL", import_form_skills_path %>.
</p>
