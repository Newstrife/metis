<%# Supporting files attached to the skill (everything but SKILL.md).
    The agent can author these directly; this panel lets the operator
    see, download, and replace them. %>
<% supporting = skill.files.reject { |f| skill.relative_path(f) == Skill::SKILL_MD }
       .sort_by { |f| skill.relative_path(f) } %>

<section class="skill-files">
  <h2 class="sec-label">Supporting files</h2>
  <p class="field-hint sec-intro">
    pi loads <code>SKILL.md</code> by default. Add reference docs,
    scripts, or examples your SKILL.md points at — pi can open them
    with its file tools when it loads this skill.
  </p>

  <% if supporting.any? %>
    <ul class="file-rows">
      <% supporting.each do |file| %>
        <li class="file-row">
          <%= link_to skill.relative_path(file), download_file_skill_path(skill, file_id: file.id),
                class: "file-name", target: "_blank", rel: "noopener" %>
          <span class="file-size"><%= number_to_human_size(file.byte_size) %></span>
          <%= button_to "Delete", destroy_file_skill_path(skill, file_id: file.id),
                method: :delete, class: "btn btn-ghost",
                form: { data: { turbo_confirm: "Delete #{skill.relative_path(file)}?" } } %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <details class="skill-add-file-wrap">
    <summary class="btn btn-ghost"><span>+ Add file</span></summary>
    <%= form_with url: add_file_skill_path(skill), multipart: true,
          class: "skill-add-file",
          data: { controller: "filename-from-file" } do |f| %>
      <div class="field">
        <%= label_tag :file, "File" %>
        <%= file_field_tag :file,
              data: { filename_from_file_target: "file",
                      action: "change->filename-from-file#filePicked" } %>
        <p class="field-hint">Up to <%= Skill::MAX_FILE_SIZE / 1.megabyte %>MB.</p>
      </div>
      <div class="field">
        <%= label_tag :path, "Filename" %>
        <%= text_field_tag :path, nil, placeholder: "style.md",
              autocomplete: "off",
              data: { filename_from_file_target: "filename",
                      action: "input->filename-from-file#filenameChanged" } %>
        <p class="field-hint">Auto-filled from the file you pick. Use slashes for folders — e.g. <code>ref/style.md</code> or <code>scripts/run.sh</code>. <code>SKILL.md</code> is reserved.</p>
      </div>
      <div class="form-actions">
        <%= f.submit "Add file", class: "btn btn-primary" %>
      </div>
    <% end %>
  </details>
</section>
