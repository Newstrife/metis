<% content_for :title, "New skill" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">New skill</h1>
    <div style="flex:1"></div>
    <%= link_to "Cancel", skills_path, class: "btn btn-ghost" %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <%= render "form", skill: @skill %>
    </div>
  </div>
</main>
