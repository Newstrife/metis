<%= form_with model: skill, url: skill.persisted? ? skill_path(skill) : skills_path, class: "conn-form" do |f| %>
  <% if skill.errors.any? %>
    <div class="flash error"><%= skill.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :slug %>
    <%= f.text_field :slug, placeholder: "summarize-doc", autocomplete: "off" %>
    <p class="field-hint">Lowercase letters, digits, and <code>-</code>. Becomes the directory pi sees.</p>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_field :description,
          placeholder: "When the agent should reach for this skill — one line.",
          autocomplete: "off" %>
    <p class="field-hint">pi reads this to decide whether to load the skill.</p>
  </div>

  <div class="field">
    <%= label_tag "skill_skill_md", "SKILL.md" %>
    <%= text_area_tag "skill[skill_md]",
          skill.skill_md_content || Skill::DEFAULT_SKILL_MD,
          id: "skill_skill_md", rows: 18 %>
    <p class="field-hint">YAML frontmatter (<code>name</code>, <code>description</code>) tells pi when to load this skill. The body below is the instructions it sees on a match.</p>
  </div>

  <label class="field-check">
    <%= f.check_box :enabled %>
    <span>Enabled</span>
  </label>

  <div class="form-actions">
    <%= f.submit(skill.persisted? ? "Save skill" : "Create skill", class: "btn btn-primary") %>
    <%= link_to "Cancel", skills_path, class: "btn btn-ghost" %>
  </div>
<% end %>
