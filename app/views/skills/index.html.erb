<% content_for :title, "Skills" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Skills</h1>
    <div style="flex:1"></div>
    <%= link_to "New skill", new_skill_path, class: "btn btn-ghost" %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="pane-lead">
        Snippets of guidance you save once. The agent picks the right
        one whenever your task matches — and can author new ones for
        you when you ask.
      </p>

      <%= form_with url: import_skills_path, method: :post, local: true, class: "conn-form" do |f| %>
        <label class="form-label" for="skill_import_url">Import from GitHub</label>
        <div style="display:flex; gap:0.5rem;">
          <%= f.text_field :url, id: "skill_import_url", class: "form-input", style: "flex:1",
                placeholder: "anthropics/skills/document-skills/pdf" %>
          <%= f.submit "Import", class: "btn btn-ghost" %>
        </div>
        <p class="form-hint">
          Paste a GitHub URL or <code>owner/repo[/path]</code>. The path
          must point to a directory containing <code>SKILL.md</code>.
        </p>
      <% end %>

      <% if @skills.any? %>
        <div class="conn-list">
          <% @skills.each do |skill| %>
            <%= render "skill", skill: skill %>
          <% end %>
        </div>
      <% else %>
        <div class="pane-empty">
          <p>No team skills yet — write one and the agent picks it up next turn.</p>
          <%= link_to "Create a skill", new_skill_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
