<% content_for :title, "Skills" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Skills</h1>
    <div style="flex:1"></div>
    <%= link_to "Import", import_form_skills_path, class: "btn btn-ghost" %>
    <%= link_to "New", new_skill_path, class: "btn btn-ghost" %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <nav class="skills-tabs">
        <%= link_to "Your skills", skills_path(tab: "team"),
              class: "skills-tab #{'is-active' if @tab == 'team'}" %>
        <%= link_to "Built-in", skills_path(tab: "builtin"),
              class: "skills-tab #{'is-active' if @tab == 'builtin'}" %>
        <%= link_to "Marketplace", skills_path(tab: "marketplace"),
              class: "skills-tab #{'is-active' if @tab == 'marketplace'}" %>
      </nav>

      <%= render "tab_#{@tab}" %>
    </div>
  </div>
</main>
