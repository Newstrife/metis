<% content_for :title, @conversation.display_title %>

<header class="shared-head">
  <div class="shared-head-inner">
    <a class="shared-brand" href="<%= root_path %>" target="_blank" rel="noopener">
      <span class="shared-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 18.5V7l7 6.5 7-6.5v11.5"/>
        </svg>
      </span>
      <span class="shared-word">Metis</span>
    </a>
    <h1 class="shared-title"><%= @conversation.display_title %></h1>
    <% author = @conversation.user %>
    <% if author %>
      <div class="shared-author">
        <span class="shared-author-avatar" aria-hidden="true"><%= author.initials %></span>
        <span class="shared-author-name"><%= author.display_label %></span>
        <span class="shared-author-dot" aria-hidden="true">·</span>
        <span class="shared-author-time">Shared <%= time_ago_in_words(@conversation.updated_at) %> ago</span>
      </div>
    <% else %>
      <div class="shared-sub">Shared <%= time_ago_in_words(@conversation.updated_at) %> ago</div>
    <% end %>
  </div>
</header>

<main class="shared">
  <div class="shared-stream">
    <div class="thread">
      <%= render partial: "messages/message",
            collection: @messages,
            as: :message,
            locals: { hide_activity: true } %>
    </div>
  </div>
</main>

<footer class="shared-foot">
  <div class="shared-foot-inner">
    Powered by <a href="<%= root_url %>" target="_blank" rel="noopener">Metis</a>
  </div>
</footer>
