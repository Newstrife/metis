<% content_for :title, "Sign in" %>

<h2>Sign in</h2>
<p class="auth-sub">Welcome back to Metis.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name),
      html: { class: "auth-form" }) do |f| %>
  <div class="auth-field">
    <%= f.label :email, class: "auth-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input" %>
  </div>

  <div class="auth-field">
    <%= f.label :password, class: "auth-label" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "auth-input" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="auth-check">
      <%= f.check_box :remember_me %>
      <span>Remember me</span>
    </label>
  <% end %>

  <%= f.submit "Sign in", class: "auth-submit" %>
<% end %>

<%= render "devise/shared/links" %>
