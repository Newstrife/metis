<% content_for :title, "Create account" %>

<h2>Create your account</h2>
<p class="auth-sub">Get started with Metis.</p>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name),
      html: { class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="auth-field">
    <%= f.label :email, class: "auth-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input" %>
  </div>

  <div class="auth-field">
    <%= f.label :password, class: "auth-label" %>
    <% if @minimum_password_length %>
      <span class="auth-hint"><%= @minimum_password_length %> characters minimum</span>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "auth-input" %>
  </div>

  <div class="auth-field">
    <%= f.label :password_confirmation, class: "auth-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
  </div>

  <%= f.submit "Create account", class: "auth-submit" %>
<% end %>

<%= render "devise/shared/links" %>
