<% content_for :title, "New team" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Create a team</h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="pane-lead">
        A team shares connectors, skills, and projects with everyone you
        invite. Your conversations stay private to you.
      </p>

      <%= form_with model: @team, url: teams_path, class: "team-form" do |form| %>
        <% if @team.errors.any? %>
          <div class="form-flash form-flash-err">
            <%= pluralize(@team.errors.count, "error") %> prevented creating the team:
            <ul>
              <% @team.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="field">
          <%= form.label :name, "Team name" %>
          <%= form.text_field :name, autofocus: true, placeholder: "Acme Engineering" %>
          <p class="field-hint">You can rename it later.</p>
        </div>

        <div class="team-form-actions">
          <%= link_to "Cancel", team_path, class: "btn btn-ghost" %>
          <%= form.submit "Create team", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
