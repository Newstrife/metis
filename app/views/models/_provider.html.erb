<%# provider: an LlmProvider, default_model: the current default LlmModel or nil %>
<section class="model-provider <%= 'is-off' unless provider.enabled? %>">
  <header class="model-provider-head">
    <h2 class="model-provider-name"><%= provider.label %></h2>
    <code class="model-key"><%= provider.key %></code>
    <% unless provider.api_key? %>
      <span class="badge badge-warn" title="No API key is configured for this provider; its models won't run.">no API key</span>
    <% end %>
    <div style="flex:1"></div>
    <% if current_user.superuser? %>
      <%= button_to provider.enabled? ? "Enabled" : "Disabled",
            model_provider_path(provider), method: :patch,
            params: { enabled: !provider.enabled? }, form_class: "inline-form",
            class: "btn btn-ghost #{'is-on' if provider.enabled?}" %>
    <% else %>
      <span class="badge"><%= provider.enabled? ? "enabled" : "disabled" %></span>
    <% end %>
  </header>

  <ul class="model-list">
    <% provider.llm_models.sort_by { |model| [ model.position, model.key ] }.each do |model| %>
      <li class="model-row <%= 'is-off' unless model.enabled? %>">
        <div class="model-id">
          <span class="model-label"><%= model.label %></span>
          <code class="model-key"><%= model.key %></code>
          <% if model == default_model %><span class="badge badge-default">default</span><% end %>
          <% if model.last_seen_at.nil? %>
            <span class="badge badge-warn" title="Not reported by pi on the last refresh.">stale</span>
          <% end %>
        </div>

        <div class="model-meta muted">
          <% if model.context_window.present? %><span><%= model.context_window / 1000 %>K ctx</span><% end %>
          <% if model.reasoning? %><span>reasoning</span><% end %>
          <% if model.input_modalities.present? %><span><%= model.input_modalities.join(" · ") %></span><% end %>
        </div>

        <div style="flex:1"></div>

        <% if current_user.superuser? %>
          <div class="model-actions">
            <% if model.enabled? && model != default_model %>
              <%= button_to "Set default", model_item_default_path(model), method: :post,
                    form_class: "inline-form", class: "btn btn-ghost btn-sm" %>
            <% end %>
            <%= button_to model.enabled? ? "Enabled" : "Disabled",
                  model_item_path(model), method: :patch,
                  params: { enabled: !model.enabled? }, form_class: "inline-form",
                  class: "btn btn-ghost btn-sm #{'is-on' if model.enabled?}" %>
          </div>
        <% else %>
          <span class="badge"><%= model.enabled? ? "enabled" : "disabled" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
