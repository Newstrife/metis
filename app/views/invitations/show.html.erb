<% content_for :title, "Team invitation" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Team invitation</h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @invitation.expired? %>
        <p class="pane-lead">This invitation has expired. Ask for a new one.</p>
      <% elsif @invitation.for?(current_user) %>
        <p class="pane-lead">
          <%= @invitation.invited_by.display_label %> invited you to join
          <strong><%= @invitation.team.name %></strong> as a <%= @invitation.role %>.
        </p>
        <%= button_to "Join #{@invitation.team.name}", accept_invitation_path(@invitation.token),
              class: "btn btn-primary" %>
      <% else %>
        <p class="pane-lead">
          This invitation was sent to <strong><%= @invitation.email %></strong>,
          but you're signed in as <strong><%= current_user.email %></strong>.
          Sign in with the invited address to accept it.
        </p>
      <% end %>
    </div>
  </div>
</main>
