<%# Replace the form frame in place. On success also refresh the
    sidebar so the bottom user-menu trigger (avatar + name) picks up
    any change to display_name or avatar without a full reload. %>
<%= turbo_stream.replace "profile_form" do %>
  <%= render "form", user: @user %>
<% end %>
<% if @user.errors.empty? %>
  <%= turbo_stream.replace "sidebar" do %>
    <%= render "settings/sidebar" %>
  <% end %>
<% end %>
