<%# Profile settings form. Submits to PATCH /profile via the
    "profile_form" turbo frame so save errors re-render in place
    without nuking the rest of the page. %>
<%= form_with model: user, url: profile_path, method: :patch,
      data: { turbo_frame: "profile_form" }, class: "profile-form" do |form| %>
  <% if flash[:notice].present? %>
    <div class="form-flash form-flash-ok"><%= flash[:notice] %></div>
  <% end %>
  <% if user.errors.any? %>
    <div class="form-flash form-flash-err">
      <%= pluralize(user.errors.count, "error") %> prevented saving your profile:
      <ul>
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-row">
    <%= form.label :display_name, "Display name" %>
    <%= form.text_field :display_name, autocomplete: "name",
          placeholder: "How others see you" %>
    <p class="form-hint">Shown in the sidebar and conversation header.</p>
  </div>

  <div class="form-row">
    <%= form.label :timezone, "Timezone" %>
    <%= form.time_zone_select :timezone, ActiveSupport::TimeZone.all,
          { include_blank: "Use browser default", model: ActiveSupport::TimeZone },
          { autocomplete: "off" } %>
    <p class="form-hint">Timestamps throughout the app render in this zone.</p>
  </div>

  <div class="form-row">
    <%= form.label :language, "Language" %>
    <%= form.select :language,
          User::AVAILABLE_LANGUAGES.map { |code| [ language_label(code), code ] },
          include_blank: "App default" %>
    <p class="form-hint">More locales arrive as translations land.</p>
  </div>

  <div class="form-row">
    <%= form.label :preferred_model, "Default model" %>
    <%= form.select :preferred_model,
          grouped_options_for_select(Agent::Catalog.grouped_model_options, user.preferred_model),
          include_blank: "Use deployment default" %>
    <p class="form-hint">Used for new conversations \u2014 still overridable per chat.</p>
  </div>

  <div class="form-actions">
    <%= form.submit "Save profile", class: "btn btn-primary" %>
  </div>
<% end %>
