<%= form_with model: connector, data: { controller: "connector-form" }, class: "conn-form" do |f| %>
  <% if connector.errors.any? %>
    <div class="flash error"><%= connector.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "metabase", autocomplete: "off" %>
    <p class="field-hint">The MCP server's key — letters, digits, <code>-</code> and <code>_</code>.
       pi prefixes the server's tools with it.</p>
  </div>

  <div class="field">
    <%= f.label :transport %>
    <%= f.select :transport, Connector.transports.keys, {},
          data: { connector_form_target: "transport", action: "connector-form#switch" } %>
  </div>

  <div class="field" data-connector-form-target="stdio">
    <%= label_tag :connector_command, "Command" %>
    <%= text_field_tag "connector[command]", connector.definition["command"],
          id: "connector_command", placeholder: "npx", autocomplete: "off" %>
    <%= label_tag :connector_args, "Arguments", class: "field-sub" %>
    <%= text_area_tag "connector[args]", Array(connector.definition["args"]).join("\n"),
          id: "connector_args", rows: 3, placeholder: "-y" %>
    <p class="field-hint">One argument per line.</p>
  </div>

  <div class="field" data-connector-form-target="http">
    <%= label_tag :connector_url, "Server URL" %>
    <%= url_field_tag "connector[url]", connector.definition["url"],
          id: "connector_url", placeholder: "https://example.com/mcp" %>
  </div>

  <div class="form-actions">
    <%= f.submit(connector.persisted? ? "Save connector" : "Create connector", class: "btn btn-primary") %>
    <%= link_to "Cancel", connectors_path, class: "btn btn-ghost" %>
  </div>
<% end %>
