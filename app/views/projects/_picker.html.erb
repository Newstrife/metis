<%# Returned by ProjectsController#picker (and #new_picker) into the
    matching turbo-frame. All connector-specific text comes from the
    picker module — adding a connector means adding a module, not
    editing this partial. %>
<% picker = ResourcePicker.for(provider) %>
<turbo-frame id="<%= project_picker_frame_id(project, provider) %>">
  <% if picker %>
    <div class="field" data-controller="select-autoopen">
      <%= label_tag nil, picker::LABEL %>
      <% if options.any? %>
        <%= select_tag "project[external_refs][#{provider}][#{picker::REF_FIELD}]",
              options_for_select([ [ "— None —", "" ] ] + options.map { |o| [ o[:label], o[:value] ] },
                                  project.ref_for(provider, picker::REF_FIELD)) %>
        <p class="field-hint"><%= picker::SUCCESS_HINT %></p>
      <% else %>
        <p class="field-hint">
          <%= link_to "Connect #{picker::CONNECTOR_NAME}", connectors_path %> <%= picker::EMPTY_HINT %>.
        </p>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
