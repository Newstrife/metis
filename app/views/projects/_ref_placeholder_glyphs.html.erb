<%# Chevron + spinner pair. CSS toggles which one is visible based on
    the surrounding turbo-frame's [aria-busy] attribute, so clicking
    the placeholder swaps the chevron for a spinner instantly while
    Turbo fetches the picker action. %>
<svg class="ref-placeholder-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M4 6l4 4 4-4"/>
</svg>
<svg class="ref-placeholder-spinner" viewBox="0 0 16 16" fill="none" aria-hidden="true">
  <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.8" stroke-opacity="0.25"/>
  <path d="M14 8a6 6 0 0 0-6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
</svg>
