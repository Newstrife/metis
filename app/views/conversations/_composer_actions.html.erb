<%# The composer's submit control: Send/Start while idle, Stop while a
    turn streams. Stop submits the hidden cancel_turn form. ChatJob
    swaps this back to Send when the turn ends. %>
<div id="composer_actions" class="composer-actions">
  <% if conversation&.turn_in_progress? %>
    <button type="submit" form="cancel_turn" class="send stop">Stop</button>
  <% else %>
    <button type="submit" class="send">
      <%= conversation ? "Send" : "Start" %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M2.5 8h9M7.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  <% end %>
</div>
