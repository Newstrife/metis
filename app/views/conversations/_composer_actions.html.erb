<%# The composer's submit control: Send/Start while idle, Stop while a
    turn streams. Stop submits the hidden cancel_turn form. ChatJob
    swaps this back to Send when the turn ends. %>
<div id="composer_actions" class="flex">
  <% if conversation&.turn_in_progress? %>
    <button type="submit" form="cancel_turn"
            class="rounded-md bg-gray-200 px-4 text-sm font-medium text-gray-700 hover:bg-gray-300">
      Stop
    </button>
  <% else %>
    <button type="submit"
            class="rounded-md bg-gray-900 px-4 text-sm font-medium text-white hover:bg-gray-700">
      <%= conversation ? "Send" : "Start" %>
    </button>
  <% end %>
</div>
