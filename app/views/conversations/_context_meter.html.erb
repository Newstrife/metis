<%# Latest pi context-window usage for the conversation. The element id
    is stable so ChatJob can repaint it after each turn. %>
<% usage = conversation.context_usage.presence || {} %>
<% window = usage["contextWindow"].to_i %>
<div id="<%= dom_id(conversation, :context) %>">
  <% if window.positive? %>
    <% percent = usage["percent"].to_f.clamp(0, 100) %>
    <div class="flex items-center gap-2 text-xs text-gray-400" title="Context window used">
      <span class="tabular-nums">
        <%= format_tokens(usage["tokens"]) %> / <%= format_tokens(window) %>
      </span>
      <span class="block h-1.5 w-28 overflow-hidden rounded-full bg-gray-100">
        <span class="block h-full rounded-full bg-gray-400" style="width: <%= percent %>%"></span>
      </span>
      <span class="tabular-nums"><%= percent.round %>%</span>
    </div>
  <% end %>
</div>
