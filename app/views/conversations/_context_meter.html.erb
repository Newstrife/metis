<%# The model pi resolved, where it ran, and its context-window usage.
    The element id is stable so ChatJob can repaint it after each turn. %>
<% model = conversation.agent_model %>
<% runtime = conversation.runtime_state %>
<% usage = conversation.context_usage %>
<% window = usage["contextWindow"].to_i %>
<span id="<%= dom_id(conversation, :context) %>" class="ctx-group">
  <% if model["name"].present? %>
    <span class="tag" title="<%= model["provider"] %>"><%= model["name"] %></span>
  <% end %>
  <% if runtime["runtime"].present? %>
    <span class="tag rt" title="<%= runtime["sandbox_id"] %>"><%= runtime["runtime"] %></span>
  <% end %>
  <% if window.positive? %>
    <% percent = usage["percent"].to_f.clamp(0, 100) %>
    <span class="ctx" title="<%= format_tokens(usage["tokens"]) %> / <%= format_tokens(window) %> tokens">
      <span class="ctx-track"><span class="ctx-fill" style="width: <%= percent %>%"></span></span>
      ctx <%= percent.round %>%
    </span>
  <% end %>
</span>
