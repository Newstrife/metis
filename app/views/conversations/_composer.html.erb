<%= form_with url: conversation_messages_path(conversation), method: :post do |form| %>
  <div class="flex gap-2">
    <textarea name="content" rows="3" placeholder="Message the agent…"
              class="flex-1 rounded-md border border-gray-300 px-3 py-2 resize-none
                     focus:outline-none focus:ring-2 focus:ring-gray-400"></textarea>
    <%= form.submit "Send",
          class: "self-stretch rounded-md bg-gray-900 px-4 text-white text-sm font-medium hover:bg-gray-700" %>
  </div>
<% end %>
