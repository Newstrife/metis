<% content_for :title, "New chat" %>

<main class="chat">
  <div class="welcome">
    <div class="welcome-mark" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M8 1.5v13M2.5 5l5.5-2 5.5 2M2.5 5v6M13.5 5v6M2.5 11l5.5 2 5.5-2" stroke-linejoin="round"/>
      </svg>
    </div>
    <h1>Start a new conversation</h1>
    <p>Ask anything. Metis runs the pi agent in a sandboxed runtime and streams the answer back live.</p>
  </div>

  <%= render "composer", conversation: nil %>
</main>
