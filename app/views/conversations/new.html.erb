<% content_for :title, "New conversation" %>

<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-semibold mb-6">New conversation</h1>

  <%= form_with model: @conversation, class: "space-y-4" do |form| %>
    <% if @conversation.errors.any? %>
      <div class="rounded-md bg-red-50 border border-red-200 p-3 text-sm text-red-700">
        <%= pluralize(@conversation.errors.count, "error") %> prevented this conversation from being saved.
      </div>
    <% end %>

    <div>
      <%= form.label :title, class: "block text-sm font-medium mb-1" %>
      <%= form.text_field :title, placeholder: "Optional",
            class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :backend, class: "block text-sm font-medium mb-1" %>
      <%= form.select :backend,
            [["Pi", "pi"], ["Claude Code (coming soon)", "claude_code"], ["Codex (coming soon)", "codex"]],
            {}, class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
      <p class="mt-1 text-xs text-gray-500">v1 runs on Pi. Other backends are placeholders.</p>
    </div>

    <div class="flex items-center gap-3">
      <%= form.submit "Create",
            class: "rounded-md bg-gray-900 px-4 py-2 text-white text-sm font-medium hover:bg-gray-700" %>
      <%= link_to "Cancel", conversations_path, class: "text-sm text-gray-500 hover:text-gray-800" %>
    </div>
  <% end %>
</div>
