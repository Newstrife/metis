<% content_for :title, @conversation.display_title %>

<div class="w-full max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold"><%= @conversation.display_title %></h1>
    <span class="text-xs uppercase tracking-wide text-gray-400"><%= @conversation.backend %></span>
  </div>

  <%= link_to "← All conversations", conversations_path,
        class: "inline-block mb-6 text-sm text-gray-500 hover:text-gray-800" %>

  <% if @messages.any? %>
    <ul class="space-y-3">
      <% @messages.each do |message| %>
        <li class="rounded-md border border-gray-200 px-4 py-3">
          <div class="text-xs uppercase tracking-wide text-gray-400 mb-1"><%= message.role %></div>
          <div class="whitespace-pre-wrap"><%= message.content %></div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">No messages yet. The chat composer arrives in a later milestone.</p>
  <% end %>
</div>
