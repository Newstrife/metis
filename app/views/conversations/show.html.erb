<% content_for :title, @conversation.display_title %>

<%= turbo_stream_from @conversation %>

<div data-controller="chat">
  <header class="mb-6">
    <%= link_to "← Conversations", conversations_path,
          class: "text-sm text-gray-500 hover:text-gray-800" %>
    <div class="flex items-center justify-between mt-1">
      <h1 class="text-xl font-semibold"><%= @conversation.display_title %></h1>
      <span class="text-xs uppercase tracking-wide text-gray-400"><%= @conversation.backend %></span>
    </div>
  </header>

  <div id="messages" data-chat-target="messages" class="space-y-4 pb-32">
    <%= render @messages %>
  </div>

  <%= render "composer", conversation: @conversation %>
</div>
