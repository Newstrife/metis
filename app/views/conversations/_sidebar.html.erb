<%# The persistent shell sidebar: brand, conversation search + list, user.
    Rendered by the "chat" layout on every conversations page. The list
    is paginated with Pagy; the infinite-scroll Stimulus controller on
    `.convos` (the scroll container) watches the sentinel target at the
    bottom and fetches the next page as a turbo_stream when it scrolls
    into view. %>
<aside id="sidebar" class="sidebar" data-controller="conversation-filter">
  <div class="ws">
    <div class="ws-name">Metis</div>
    <div style="flex:1"></div>
    <button type="button" class="ico-btn theme-toggle" data-controller="theme"
            data-action="theme#toggle" title="Switch color scheme" aria-label="Switch color scheme">
      <svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M13 9.5A5.5 5.5 0 016.5 3a5.5 5.5 0 106.5 6.5z" stroke-linejoin="round"/>
      </svg>
      <svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="3.2"/>
        <path d="M8 1.5v1.6M8 12.9v1.6M14.5 8h-1.6M3.1 8H1.5M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1M12.6 12.6l-1.1-1.1M4.5 4.5L3.4 3.4" stroke-linecap="round"/>
      </svg>
    </button>
    <%= link_to conversations_path, class: "ico-btn", title: "New chat",
          data: { turbo_frame: "main" } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M8 3v10M3 8h10" stroke-linecap="round"/>
      </svg>
    <% end %>
  </div>

  <div class="search">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14" stroke-linecap="round"/>
    </svg>
    <input type="search" placeholder="Search conversations" aria-label="Search conversations"
           data-conversation-filter-target="query"
           data-action="input->conversation-filter#filter">
  </div>

  <nav class="convos" aria-label="Conversations" data-turbo-prefetch="false"
       data-controller="infinite-scroll active-link">
    <div id="convos-list">
      <% if @conversations.any? %>
        <%= render "conversations/convo_items",
              conversations: @conversations,
              last_bucket: nil,
              grouped: true %>
        <%= render "conversations/convo_sentinel",
              pagy: @sidebar_pagy,
              last_bucket: conversation_time_bucket(@conversations.last.updated_at) %>
      <% else %>
        <div class="convos-empty">No conversations yet — start one on the right.</div>
      <% end %>
    </div>
    <div class="convos-empty" data-conversation-filter-target="empty" hidden>No matches.</div>
  </nav>

  <nav class="nav" aria-label="Navigate">
    <div class="grp-label">Navigate</div>
    <%= link_to connectors_path,
          class: "nav-item#{' on' if controller_name == 'connectors'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M5.5 2v3.2M10.5 2v3.2M4 5.2h8v2.3a4 4 0 01-8 0V5.2zM8 11.5V14"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Connectors</span>
    <% end %>
    <%= link_to profile_path,
          class: "nav-item#{' on' if controller_name == 'profiles'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="8" cy="5.5" r="2.5"/>
        <path d="M3 14c0-2.5 2.2-4.5 5-4.5s5 2 5 4.5" stroke-linecap="round"/>
      </svg>
      <span>Profile</span>
    <% end %>
  </nav>

  <div class="user">
    <%= link_to profile_path, class: "user-link", title: "Edit profile" do %>
      <div class="avatar" aria-hidden="true"><%= current_user.initials %></div>
      <div class="who"><div class="nm"><%= current_user.display_label %></div></div>
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete,
          class: "signout", title: "Sign out", form: { data: { turbo: false } } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 14H3.5A1.5 1.5 0 012 12.5v-9A1.5 1.5 0 013.5 2H6M10.5 11l3-3-3-3M13.5 8H6"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %>
  </div>
</aside>
