<%# One row in the sidebar conversation list. Targets the #main
    turbo-frame so picking a conversation swaps only the right pane —
    the sidebar (and its scroll/pagination state) stays put.

    The conversation-title Stimulus controller enables click-to-edit
    directly in the sidebar row. %>
<%= link_to conversation,
      id: dom_id(conversation),
      class: "convo#{' on' if conversation == @conversation}",
      data: {
        conversation_filter_target: "item",
        active_link_target: "link",
        turbo_frame: "main",
        title: conversation.display_title,
        controller: "conversation-title",
        conversation_title_url_value: conversation_path(conversation)
      } do %>
  <span class="tt"
        id="<%= dom_id(conversation, :sidebar_title) %>"
        data-conversation-title-target="text"
        data-action="click->conversation-title#edit"><%= conversation.display_title %></span>
  <input class="tt-input"
         type="text"
         data-conversation-title-target="input"
         data-action="keydown->conversation-title#keydown blur->conversation-title#save"
         hidden />
<% end %>
