<%# Sidebar user menu — the bottom-of-sidebar identity card, now a
    popup trigger. Houses Profile / Settings links, a live theme
    tri-toggle that persists via PATCH /profile/theme, and Sign out.
    Rendered by both the chat and settings sidebars so the surface
    is identical across the app. %>
<% effective_theme = (current_user.theme.presence || "system") %>
<div class="user-menu" data-controller="user-menu"
     data-user-menu-theme-url-value="<%= update_theme_profile_path %>">
  <button type="button" class="user-menu-trigger"
          data-action="click->user-menu#toggle"
          aria-haspopup="true" aria-label="Open user menu">
    <div class="avatar" aria-hidden="true"><%= current_user.initials %></div>
    <div class="who"><div class="nm"><%= current_user.display_label %></div></div>
    <svg class="user-menu-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor"
         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 6l4 4 4-4"/>
    </svg>
  </button>

  <div class="user-menu-panel" data-user-menu-target="panel" role="menu">
    <div class="user-menu-id">
      <div class="avatar" aria-hidden="true"><%= current_user.initials %></div>
      <div class="user-menu-id-text">
        <div class="user-menu-name"><%= current_user.display_label %></div>
        <div class="user-menu-email"><%= current_user.email %></div>
      </div>
    </div>

    <div class="user-menu-sep"></div>

    <%= link_to profile_path, class: "user-menu-item", role: "menuitem",
          data: { turbo_frame: "_top" } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8" cy="5.5" r="2.5"/><path d="M3 14c0-2.5 2.2-4.5 5-4.5s5 2 5 4.5"/>
      </svg>
      <span>Profile</span>
    <% end %>

    <%= link_to "/settings", class: "user-menu-item", role: "menuitem",
          data: { turbo_frame: "_top" } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8" cy="8" r="2.2"/>
        <path d="M13.5 8a5.5 5.5 0 00-.1-1.1l1.4-1-1.4-2.4-1.6.6a5.5 5.5 0 00-1.9-1.1L9.5 1h-3l-.4 1.9a5.5 5.5 0 00-1.9 1.1l-1.6-.6L1.2 5.9l1.4 1a5.5 5.5 0 000 2.2l-1.4 1 1.4 2.4 1.6-.6a5.5 5.5 0 001.9 1.1L6.5 15h3l.4-1.9a5.5 5.5 0 001.9-1.1l1.6.6 1.4-2.4-1.4-1c.07-.36.1-.73.1-1.1z"/>
      </svg>
      <span>Settings</span>
    <% end %>

    <div class="user-menu-sep"></div>

    <div class="user-menu-row">
      <span class="user-menu-label">Theme</span>
      <div class="theme-seg" role="group" aria-label="Theme">
        <% User::THEMES.each do |theme_key| %>
          <button type="button"
                  class="theme-seg-btn<%= ' on' if effective_theme == theme_key %>"
                  data-theme="<%= theme_key %>"
                  data-user-menu-target="themeButton"
                  data-action="click->user-menu#switchTheme">
            <%= theme_key.capitalize %>
          </button>
        <% end %>
      </div>
    </div>

    <div class="user-menu-sep"></div>

    <%= button_to destroy_user_session_path, method: :delete,
          class: "user-menu-item user-menu-signout", form: { data: { turbo: false } } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 14H3.5A1.5 1.5 0 012 12.5v-9A1.5 1.5 0 013.5 2H6M10.5 11l3-3-3-3M13.5 8H6"/>
      </svg>
      <span>Sign out</span>
    <% end %>
  </div>
</div>
