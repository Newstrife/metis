<%# Persistent sidebar for the settings shell — a back link to the
    chat plus the section nav. The active section is matched on
    `controller_name` (so /settings/profile lights up "Profile" via
    ProfilesController, etc.). %>
<aside id="sidebar" class="sidebar settings-sidebar">
  <div class="ws">
    <%= link_to root_path, class: "settings-back", title: "Back to Metis" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 3L5 8l5 5"/>
      </svg>
      <span>Back</span>
    <% end %>
    <div style="flex:1"></div>
    <button type="button" class="ico-btn theme-toggle" data-controller="theme"
            data-action="theme#toggle" title="Switch color scheme" aria-label="Switch color scheme">
      <svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M13 9.5A5.5 5.5 0 016.5 3a5.5 5.5 0 106.5 6.5z" stroke-linejoin="round"/>
      </svg>
      <svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="3.2"/>
        <path d="M8 1.5v1.6M8 12.9v1.6M14.5 8h-1.6M3.1 8H1.5M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1M12.6 12.6l-1.1-1.1M4.5 4.5L3.4 3.4" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="settings-nav" aria-label="Settings sections">
    <div class="grp-label">Settings</div>
    <%= link_to profile_path,
          class: "nav-item#{' on' if controller_name == 'profiles'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="8" cy="5.5" r="2.5"/>
        <path d="M3 14c0-2.5 2.2-4.5 5-4.5s5 2 5 4.5" stroke-linecap="round"/>
      </svg>
      <span>Profile</span>
    <% end %>
    <%= link_to connectors_path,
          class: "nav-item#{' on' if controller_name == 'connectors'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M5.5 2v3.2M10.5 2v3.2M4 5.2h8v2.3a4 4 0 01-8 0V5.2zM8 11.5V14"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Connectors</span>
    <% end %>
    <%= link_to skills_path,
          class: "nav-item#{' on' if controller_name == 'skills'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M3.5 3h9v3h-9zM3.5 9h9v3.5h-9zM2 4.5h1.5M2 11h1.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Skills</span>
    <% end %>
  </nav>

  <div class="user">
    <div class="user-link" title="Signed in as">
      <div class="avatar" aria-hidden="true"><%= current_user.initials %></div>
      <div class="who"><div class="nm"><%= current_user.display_label %></div></div>
    </div>
    <%= button_to destroy_user_session_path, method: :delete,
          class: "signout", title: "Sign out", form: { data: { turbo: false } } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 14H3.5A1.5 1.5 0 012 12.5v-9A1.5 1.5 0 013.5 2H6M10.5 11l3-3-3-3M13.5 8H6"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %>
  </div>
</aside>
