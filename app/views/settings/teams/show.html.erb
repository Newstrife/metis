<% content_for :title, "Team" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= @team.personal? ? "Personal workspace" : @team.name %></h1>
    <div style="flex:1"></div>
    <%= link_to "New team", new_team_path, class: "btn btn-ghost" %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @team.personal? %>
        <p class="pane-lead">
          You're in your personal workspace — a team of one. Create a team
          to share connectors, skills, and projects with others.
        </p>
        <%= link_to "Create a team", new_team_path, class: "btn btn-primary" %>
      <% else %>
        <% manager = current_membership&.manages_team? %>
        <% owner = current_membership&.owner? %>
        <p class="pane-lead">
          Members share this team's connectors, skills, and projects.
          Conversations stay private to whoever started them.
        </p>

        <% if manager %>
          <%= form_with model: @team, url: team_path, method: :patch, class: "team-rename" do |form| %>
            <%= form.label :name, "Team name", class: "team-form-label" %>
            <div class="team-rename-row">
              <%= form.text_field :name, class: "team-input" %>
              <%= form.submit "Save", class: "btn btn-ghost" %>
            </div>
          <% end %>
        <% end %>

        <div class="cat-label">Members</div>
        <ul class="member-list">
          <% @memberships.each do |membership| %>
            <li class="member-row">
              <%= avatar_for membership.user, size: 32 %>
              <div class="member-id">
                <div class="member-name"><%= membership.user.display_label %></div>
                <div class="member-email"><%= membership.user.email %></div>
              </div>
              <% if manager && !membership.owner? && membership.user_id != current_user.id %>
                <div class="member-actions">
                  <% next_role = membership.member? ? "admin" : "member" %>
                  <%= button_to membership.role.titleize, team_membership_path(membership), method: :patch,
                        params: { membership: { role: next_role } }, form_class: "inline-form",
                        class: "btn btn-ghost btn-sm", title: "Make #{next_role}" %>
                  <% if owner %>
                    <%= button_to "Make owner", transfer_team_membership_path(membership), method: :post,
                          form: { class: "inline-form", data: { turbo_confirm: "Make #{membership.user.display_label} the owner? You'll step down to admin." } },
                          class: "btn btn-ghost btn-sm" %>
                  <% end %>
                  <%= button_to "Remove", team_membership_path(membership), method: :delete,
                        form: { class: "inline-form", data: { turbo_confirm: "Remove #{membership.user.display_label} from #{@team.name}?" } },
                        class: "btn btn-ghost btn-sm" %>
                </div>
              <% else %>
                <span class="member-role"><%= membership.role.titleize %></span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <% if manager %>
          <div class="cat-label">Invite a teammate</div>
          <%= form_with model: @invitation, url: team_invitations_path, class: "invite-form" do |form| %>
            <div class="invite-row">
              <%= form.email_field :email, placeholder: "teammate@example.com", "aria-label": "Email", class: "team-input" %>
              <%= form.select :role, Invitation::INVITABLE_ROLES.map { |r| [ r.titleize, r ] }, {}, class: "team-input" %>
              <%= form.submit "Send invite", class: "btn btn-primary" %>
            </div>
          <% end %>

          <% if @pending_invitations.any? %>
            <ul class="member-list">
              <% @pending_invitations.each do |invitation| %>
                <li class="member-row">
                  <div class="member-id">
                    <div class="member-name"><%= invitation.email %></div>
                    <div class="member-email">Pending · <%= invitation.role.titleize %></div>
                  </div>
                  <%= button_to "Revoke", team_invitation_path(invitation),
                        method: :delete, class: "btn btn-ghost btn-sm" %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>

        <div class="cat-label">Danger zone</div>
        <% if owner %>
          <%= button_to "Delete team", team_path, method: :delete, class: "btn btn-danger",
                form: { data: { turbo_confirm: "Delete #{@team.name}? This removes the team for everyone." } } %>
        <% else %>
          <%= button_to "Leave team", leave_team_memberships_path, method: :delete, class: "btn btn-danger",
                form: { data: { turbo_confirm: "Leave #{@team.name}? You'll lose access to its shared resources." } } %>
        <% end %>
      <% end %>
    </div>
  </div>
</main>
