<% content_for :title, "Team" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Team</h1>
    <div style="flex:1"></div>
    <%= link_to "New team", new_team_path, class: "btn btn-ghost" %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @team.personal? %>
        <p class="pane-lead">
          You're in your personal workspace — a team of one. Create a team
          to share connectors, skills, and projects with others.
        </p>
        <%= link_to "Create a team", new_team_path, class: "btn btn-primary" %>
      <% else %>
        <p class="pane-lead">
          Members share this team's connectors, skills, and projects.
          Conversations stay private to whoever started them.
        </p>

        <% if current_membership&.manages_team? %>
          <%= form_with model: @team, url: team_path, method: :patch, class: "team-rename" do |form| %>
            <div class="field">
              <%= form.label :name, "Team name" %>
              <div class="team-rename-row">
                <%= form.text_field :name %>
                <%= form.submit "Save", class: "btn btn-ghost" %>
              </div>
            </div>
          <% end %>
        <% end %>

        <div class="cat-label">Members</div>
        <ul class="member-list">
          <% @memberships.each do |membership| %>
            <li class="member-row">
              <%= avatar_for membership.user, size: 32 %>
              <div class="member-id">
                <div class="member-name"><%= membership.user.display_label %></div>
                <div class="member-email"><%= membership.user.email %></div>
              </div>
              <span class="member-role"><%= membership.role.titleize %></span>
            </li>
          <% end %>
        </ul>

        <% if current_membership&.manages_team? %>
          <div class="cat-label">Invite a teammate</div>
          <%= form_with model: @invitation, url: team_invitations_path, class: "invite-form" do |form| %>
            <div class="invite-row">
              <%= form.email_field :email, placeholder: "teammate@example.com", "aria-label": "Email" %>
              <%= form.select :role, Invitation::INVITABLE_ROLES.map { |r| [ r.titleize, r ] } %>
              <%= form.submit "Send invite", class: "btn btn-primary" %>
            </div>
          <% end %>

          <% if @pending_invitations.any? %>
            <ul class="member-list">
              <% @pending_invitations.each do |invitation| %>
                <li class="member-row">
                  <div class="member-id">
                    <div class="member-name"><%= invitation.email %></div>
                    <div class="member-email">Pending · <%= invitation.role.titleize %></div>
                  </div>
                  <%= button_to "Revoke", team_invitation_path(invitation),
                        method: :delete, class: "btn btn-ghost" %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>

        <% if current_membership&.owner? %>
          <div class="cat-label">Danger zone</div>
          <%= button_to "Delete team", team_path, method: :delete, class: "btn btn-danger",
                form: { data: { turbo_confirm: "Delete #{@team.name}? This removes the team for everyone." } } %>
        <% end %>
      <% end %>
    </div>
  </div>
</main>
