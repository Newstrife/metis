<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Metis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Metis">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      // Apply the saved color scheme before paint — no flash. Falls back
      // to the OS setting; the sidebar toggle persists an explicit choice.
      (function () {
        var saved = localStorage.getItem("metisTheme");
        document.documentElement.dataset.theme =
          saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      })();
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Schibsted+Grotesk:wght@500;600;700&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-shell">
    <div class="app">
      <%= render "conversations/sidebar" %>
      <%# Sidebar conversation links target this frame, so picking a
          conversation swaps only the main pane and the sidebar keeps
          its scroll/paginated state. `advance` updates the URL so
          back/forward and refresh still work. Forms that need a full
          page reload (e.g. creating a new conversation, since the
          sidebar must pick up the new row) break out with
          `data-turbo-frame="_top"`. %>
      <turbo-frame id="main" data-turbo-action="advance">
        <%= yield %>
      </turbo-frame>
    </div>

    <% if notice || alert %>
      <div class="flash-toast">
        <% if notice %>
          <div class="flash notice">
            <%= notice %>
            <% if flash[:undo_archive_id] %>
              <%= button_to "Undo",
                    unarchive_conversation_path(flash[:undo_archive_id]),
                    method: :post,
                    class: "flash-undo",
                    form: { data: { turbo_frame: "_top" } } %>
            <% end %>
          </div>
        <% end %>
        <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      </div>
    <% end %>
  </body>
</html>
