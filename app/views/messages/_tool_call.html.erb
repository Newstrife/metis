<details id="tool_<%= tool_call_id %>" class="toolcall<%= " err" if is_error %>" <%= "open" if local_assigns.fetch(:open, true) %>>
  <summary class="toolcall-head">
    <span class="toolcall-fn"><%= skill_slug.present? ? "skill: #{skill_slug}" : name %></span>
    <span class="toolcall-status"><%= status %></span>
  </summary>

  <% if args.present? %>
    <pre><%= JSON.pretty_generate(args) %></pre>
  <% end %>

  <% if output.present? %>
    <pre><%= output %></pre>
  <% end %>
</details>
