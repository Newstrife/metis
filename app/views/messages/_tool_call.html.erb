<div id="tool_<%= tool_call_id %>" class="toolcall<%= " err" if is_error %>">
  <div class="toolcall-head">
    <span class="toolcall-fn"><%= name %></span>
    <span class="toolcall-status"><%= status %></span>
  </div>

  <% if args.present? %>
    <pre><%= args.to_json %></pre>
  <% end %>

  <% if output.present? %>
    <pre><%= output %></pre>
  <% end %>
</div>
