<div id="<%= dom_id(message) %>_artifacts" class="msg-artifacts">
  <% message.artifacts.each do |artifact| %>
    <% if artifact.image? %>
      <a href="<%= rails_blob_path(artifact) %>" target="_blank" rel="noopener" class="art-image-link">
        <%= image_tag rails_blob_path(artifact), class: "art-image", alt: artifact.filename %>
      </a>
    <% else %>
      <%= link_to rails_blob_path(artifact, disposition: "attachment"), class: "art-file" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        <span class="art-name"><%= artifact.filename %></span>
        <span class="art-size"><%= number_to_human_size(artifact.byte_size) %></span>
      <% end %>
    <% end %>
  <% end %>
</div>
