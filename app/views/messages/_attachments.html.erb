<% if message.images.attached? %>
  <div class="att-images">
    <% message.images.each do |image| %>
      <a href="<%= rails_blob_path(image) %>" target="_blank" rel="noopener">
        <%= image_tag rails_blob_path(image), class: "att-image", alt: image.filename %>
      </a>
    <% end %>
  </div>
<% end %>

<% if message.files.attached? %>
  <div class="att-files">
    <% message.files.each do |file| %>
      <%= link_to rails_blob_path(file, disposition: "attachment"), class: "att-file" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        <span class="att-name"><%= file.filename %></span>
        <span class="att-size"><%= number_to_human_size(file.byte_size) %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
