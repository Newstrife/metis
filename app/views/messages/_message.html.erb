<% if message.user? %>
  <%# User: a contained bubble on the accent fill, aligned right. %>
  <div id="<%= dom_id(message) %>" class="msg-user">
    <div class="bubble">
      <% if message.attachments? %>
        <%= render "messages/attachments", message: message %>
      <% end %>
      <div id="<%= dom_id(message) %>_body"
           class="chat-content"><%= markdown(message.content) %></div>
    </div>
    <div class="msg-stamp"><%= time_ago_in_words(message.created_at) %> ago</div>
  </div>
<% else %>
  <%# Assistant: a card beside the agent mark, room for code and tables.
      The outer .msg-row is the stable element id — a turn error is
      broadcast-appended into it, landing below the card. %>
  <div id="<%= dom_id(message) %>" class="msg-row">
    <div class="msg-ai">
      <div class="ai-mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M8 1.5v13M2.5 5l5.5-2 5.5 2M2.5 5v6M13.5 5v6M2.5 11l5.5 2 5.5-2" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="ai-card">
        <% if message.attachments? %>
          <%= render "messages/attachments", message: message %>
        <% end %>

        <%= render "messages/activity", message: message %>

        <div id="<%= dom_id(message) %>_body"
             class="chat-content"><%= markdown(message.content) %></div>

        <% if message.streaming? || message.pending? %>
          <span id="<%= dom_id(message) %>_indicator" class="msg-indicator">●</span>
        <% end %>

        <% if message.canceled? %>
          <div class="msg-flag">Stopped</div>
        <% end %>

        <div id="<%= dom_id(message) %>_meta"
             class="msg-meta"><%= message_meta(message) %></div>
      </div>
    </div>
  </div>
<% end %>
