<% if message.user? %>
  <%# User: a contained bubble, aligned to the right. %>
  <div id="<%= dom_id(message) %>" class="flex justify-end">
    <div class="max-w-[85%] rounded-2xl bg-gray-100 px-4 py-2.5">
      <% if message.attachments? %>
        <%= render "messages/attachments", message: message %>
      <% end %>
      <div id="<%= dom_id(message) %>_body"
           class="chat-content break-words"><%= markdown(message.content) %></div>
    </div>
  </div>
<% else %>
  <%# Assistant: full width, no bubble, so code and tables have room. %>
  <div id="<%= dom_id(message) %>" class="pr-6">
    <% if message.attachments? %>
      <%= render "messages/attachments", message: message %>
    <% end %>

    <%= render "messages/activity", message: message %>

    <div id="<%= dom_id(message) %>_body"
         class="chat-content break-words"><%= markdown(message.content) %></div>

    <% if message.streaming? || message.pending? %>
      <span id="<%= dom_id(message) %>_indicator"
            class="inline-block animate-pulse text-gray-400">●</span>
    <% end %>

    <% if message.canceled? %>
      <div class="mt-1 text-xs text-gray-400">Stopped</div>
    <% end %>

    <div id="<%= dom_id(message) %>_meta"
         class="mt-2 text-xs text-gray-400 tabular-nums empty:hidden"><%= message_meta(message) %></div>
  </div>
<% end %>
