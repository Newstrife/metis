<%# An assistant turn's reasoning + tool calls. Open while the turn
    streams — the broadcaster appends into the inner divs, which must
    exist — then collapsed once the turn is done. Skipped entirely for
    a finished turn that had neither. %>
<% if !message.done? || message.reasoning.present? || message.tool_calls.any? %>
  <details id="<%= dom_id(message) %>_activity" class="activity" <%= "open" unless message.done? %>>
    <summary><%= activity_summary(message) %></summary>
    <div>
      <div id="<%= dom_id(message) %>_reasoning"
           class="reasoning"><%= message.reasoning %></div>
      <div id="<%= dom_id(message) %>_tools" class="tools">
        <% message.tool_calls.each do |call| %>
          <%= render "messages/tool_call",
                tool_call_id: call["tool_call_id"], name: call["name"], args: call["args"],
                output: call["output"], is_error: call["is_error"], status: call["status"],
                open: false %>
        <% end %>
      </div>
    </div>
  </details>
<% end %>
